# Existing environment variables take precedence. No secrets are required for a local vLLM server.
MODEL_NAME=Qwen/Qwen2.5-3B-Instruct-AWQ
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=EMPTY

# Use the unfiltered table URL. Select one row with --source-id 19744.
SOURCE_TEXT_URL=https://dev.macrostrat.org/api/pg/source_text
ENTITY_TYPE_URL=https://dev.macrostrat.org/api/pg/kg_entity_type
RELATIONSHIP_TYPE_URL=https://dev.macrostrat.org/api/pg/kg_relationship_type
RECORD_RUN_URL=https://macrostrat-xdd.dev.svc.macrostrat.org/record_run

# Optional, separate Bearer tokens for the source API and /record_run.
SOURCE_API_TOKEN=
RECORD_API_TOKEN=
EXTRACTION_PIPELINE_ID=0
MODEL_VERSION=0

# start_vllm.sh settings. These do not change an already running server.
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_MODEL_LEN=2048
VLLM_MAX_NUM_SEQS=1
VLLM_MAX_NUM_BATCHED_TOKENS=512
